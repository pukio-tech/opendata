datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // native: local (Windows) · rhel-openssl-3.0.x: runtime de Vercel (Node 18+)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  ADMIN
  EDITOR
  USER
}

/// Usuario del panel (Control Center).
/// ADMIN = superadministrador: todas las apps + gestión de usuarios.
/// EDITOR / USER = solo las apps asignadas en `user_apps`.
model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  name        String?
  role        Role       @default(EDITOR)
  active      Boolean    @default(true)
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
  apps        UserApp[]

  @@map("users")
}

/// Aplicaciones gestionadas desde el panel (opendata, gym, …). El id coincide con lib/apps.ts del panel.
model PanelApp {
  id          String    @id @db.VarChar(40)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  users       UserApp[]

  @@map("panel_apps")
}

/// Acceso de un usuario a una app del panel (los ADMIN no lo necesitan: ven todas).
model UserApp {
  userId    String   @map("user_id")
  appId     String   @map("app_id") @db.VarChar(40)
  grantedBy String?  @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app       PanelApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
  @@index([appId])
  @@map("user_apps")
}

model TouristPlace {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  category        String?
  department      String?
  province        String?
  district        String?
  address         String?
  imageUrl        String?
  gallery         String[] @default([])
  rating          Float?   @default(0)
  isPublished     Boolean  @default(true)

  // Coordenadas geográficas
  latitude        Float
  longitude       Float

  // Campos SEO
  metaTitle       String?
  metaDescription String?  @db.Text
  keywords        String?
  canonicalUrl    String?
  ogImage         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("tourist_places")
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  content         String    @db.Text
  summary         String?   @db.Text
  coverImage      String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?

  // Relación con autor
  authorId        String?
  author          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Campos SEO
  metaTitle       String?
  metaDescription String?   @db.Text
  keywords        String?
  canonicalUrl    String?
  ogImage         String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("blog_posts")
}
